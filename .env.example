# Postgres connection string. Any provider works: Docker, Supabase, Neon, Railway.
# Behind a pooler, use the pooled connection string.
DATABASE_URL=postgres://postgres:mail@localhost:5432/mail

# From the Resend dashboard.
RESEND_API_KEY=
# Signing secret of the received-mail webhook.
RESEND_WEBHOOK_SECRET=

# Public URL this app is reachable at. Must be HTTPS for Resend to deliver webhooks.
APP_URL=http://localhost:3000

# At least 32 characters each. Generate both with:
#   node -e "const r=n=>require('crypto').randomBytes(n).toString('hex');console.log('SESSION_SECRET='+r(32));console.log('RECONCILE_TOKEN='+r(32))"
SESSION_SECRET=
RECONCILE_TOKEN=

# Copy of every message is sent here so mail stays readable on a phone. Optional.
FORWARD_TO=

# fs | s3 | postgres
STORAGE_DRIVER=fs
# STORAGE_DRIVER=fs
FS_STORAGE_PATH=./storage/attachments
# STORAGE_DRIVER=s3 (also covers R2, MinIO, Backblaze)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Leave on outside local evaluation.
REQUIRE_TOTP=true

# Separate database for tests; they truncate every table.
# TEST_DATABASE_URL=postgres://postgres:mail@localhost:5432/mail_test

# Fixes the first-run setup token instead of generating one per boot.
# SETUP_TOKEN=

# Set true only when a reverse proxy in front rewrites x-forwarded-for.
TRUST_PROXY=false

# Shared with the Cloudflare Email Worker so only it can post mail here.
# 32+ characters. Only needed when receiving through Cloudflare.
# INBOUND_SECRET=
